# Google OAuth2 credentials — create a "Desktop App" OAuth client at
# https://console.cloud.google.com/apis/credentials
# Enable the Google Calendar API for your project first.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OpenWeatherMap API key (free tier is sufficient)
# https://openweathermap.org/api
OPENWEATHER_API_KEY=your-api-key

# Your location for weather (decimal degrees)
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
