{
  "name": "pi-calendar",
  "version": "1.0.0",
  "description": "Touchscreen calendar for Raspberry Pi",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:linux:arm64": "npm run build && electron-builder --linux --arm64",
    "build:pi": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "electron-store": "^10.0.0",
    "googleapis": "^144.0.0",
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "date-fns": "^3.6.0",
    "electron": "^43.3.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.danlafeir.picalendar",
    "productName": "Pi Calendar",
    "directories": {
      "buildResources": "resources"
    },
    "files": ["out/**/*"],
    "extraResources": [
      {
        "from": "resources/sounds",
        "to": "sounds",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": "dir",
      "category": "Utility",
      "executableName": "pi-calendar"
    }
  }
}
